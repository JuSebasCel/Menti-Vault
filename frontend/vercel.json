{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/((?!apps/|un$|un/).*)", "destination": "/apps/vault/$1", "permanent": false }
  ],
  "rewrites": [
    { "source": "/un", "destination": "/apps/vault/un/index.html" },
    { "source": "/un/", "destination": "/apps/vault/un/index.html" },
    { "source": "/un/(.*)", "destination": "/apps/vault/un/$1" },
    { "source": "/apps/vault", "destination": "/apps/vault/index.html" },
    { "source": "/apps/vault/(.*)", "destination": "/apps/vault/index.html" }
  ]
}
