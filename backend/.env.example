# Copia este archivo a backend/.env (ya está en .gitignore) y completa los
# valores reales. El backend falla al arrancar, con el nombre de la variable
# que falta, si alguna de las obligatorias está vacía.

# ---------------------------------------------------------------------------
# Supabase (obligatorias)
# ---------------------------------------------------------------------------
# Las mismas dos que usa el frontend, y a propósito: este backend consulta
# Supabase con la anon key MÁS el access_token del usuario que hizo la
# petición, de modo que RLS sigue aplicando fila por fila igual que cuando el
# navegador consulta directo.
#
# NO existe una variable para la service-role key, y no debe agregarse: una
# service-role key salta RLS, y el aislamiento entre usuarios de este proyecto
# vive entero en RLS (supabase/migrations/*_esquema_propio.sql).
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu-anon-key

# ---------------------------------------------------------------------------
# OpenAI (opcionales: solo los identificadores de modelo)
# ---------------------------------------------------------------------------
# No hay ninguna variable con una API key de OpenAI. Cada usuario guarda la
# suya cifrada en Supabase Vault y el backend la lee por RPC con el token de
# esa persona (`leer_mi_api_key()`); una clave del servidor haría que todo el
# grupo consumiera la cuota de una sola cuenta, en contra de "API key propia
# por usuario" del README.
#
# Los identificadores van por entorno para poder cambiar de modelo sin
# desplegar. El de transcripción debe soportar `verbose_json` con timestamps
# por segmento: sin eso no hay coordenada real y las fichas pierden su
# trazabilidad al segundo.
OPENAI_MODELO_TRANSCRIPCION=whisper-1
OPENAI_MODELO_ANALISIS=gpt-4.1
OPENAI_MODELO_AGENTE=gpt-4.1-mini

# ---------------------------------------------------------------------------
# Red (opcional)
# ---------------------------------------------------------------------------
# Orígenes que pueden llamar a este backend, separados por coma. En producción
# se pone el dominio real del frontend en Vercel, nunca `*`.
BITACORA_ORIGENES_PERMITIDOS=http://localhost:5173

# ---------------------------------------------------------------------------
# LangSmith (opcional, sin uso todavía)
# ---------------------------------------------------------------------------
# El README lo declara como observabilidad de llamadas a LLM. Se documenta
# aquí para que el día que se conecte no haya que adivinar los nombres, pero
# el backend NO lo lee todavía: declarar una variable que nadie usa como si
# funcionara es peor que no tenerla.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=bitacora-ai

# Secreto del servidor para las claves compartidas de la administración.
# Su huella SHA-256 tiene que estar en la tabla `secreto_del_servidor`.
BITACORA_SECRETO_DEL_SERVIDOR=

# ---------------------------------------------------------------------------
# Artículos (Claude)
# ---------------------------------------------------------------------------
# Los artículos se redactan con Claude y una sola clave de la plataforma, no
# la de cada persona. Sin ella, el paso de redactar responde que no está
# activado. El modelo es Sonnet 5.5 si no se dice otro.
ANTHROPIC_API_KEY=
# BITACORA_MODELO_DE_ARTICULOS=claude-sonnet-5-5
